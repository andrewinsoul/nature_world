<Layouts.app flash={@flash}>
  <% selected_citizen =
    Enum.find(
      @world.citizens,
      &(&1.id == @selected_citizen_id)
    ) %>

  <div class="world-background relative min-h-screen overflow-hidden text-white">
    
<!-- Ambient Background -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden">
      <div class="
        absolute
        -top-32
        left-1/3
        h-[600px]
        w-[600px]
        rounded-full
        bg-emerald-500/10
        blur-[180px]
        animate-pulse
      ">
      </div>

      <div class="
        absolute
        bottom-0
        right-0
        h-[500px]
        w-[500px]
        rounded-full
        bg-cyan-500/5
        blur-[200px]
      ">
      </div>
    </div>
    
<!-- Main Content -->
    <div class="relative z-10">
      
<!-- Hero -->
      <div class="pt-6 text-center">
        <h1 class="hero-title text-5xl font-black tracking-tight sm:text-6xl">
          Nature World
        </h1>

        <p class="mt-5 text-lg text-zinc-400">
          A Living Visualization of the BEAM Runtime
        </p>
      </div>
      
<!-- World -->
      <div class="
        mx-auto
        mt-8
        max-w-7xl
        px-6
        lg:grid
        lg:grid-cols-[1fr_360px]
        lg:gap-10
        items-start
      ">
        
<!-- Simulation -->
<div>
<%= if is_nil(@selected_citizen_id) do %>
            <div class="
              mb-3
              flex
              items-center
              justify-center
              gap-2
              text-sm
              text-zinc-400
            ">
              <span class="
                inline-flex
                h-6
                w-6
                items-center
                justify-center
                rounded-full
                border
                border-zinc-700
                bg-zinc-900/60
                text-xs
                text-zinc-300
              ">
                ↖
              </span>

              <span>
                Click a citizen to explore its process
              </span>
            </div>
          <% end %>
        <div class="
    world-stage
    relative
    h-[52vh]
    min-h-[380px]
    max-h-[680px]
    lg:h-[calc(100vh-210px)]
    w-full
  ">
          <div class="world-grid"></div>

          <div class="world-vignette"></div>
          
<!-- Citizens -->
          <%= for citizen <- @world.citizens do %>
            <.citizen
              citizen={citizen}
              selected={citizen.id == @selected_citizen_id}
              highlighted={
                Enum.any?(@world.messages, &(&1.from == citizen.id or &1.to == citizen.id))
              }
            />
          <% end %>
          
<!-- Messages -->
          <%= for message <- @world.messages do %>
            <.message
              message={message}
              citizens={@world.citizens}
            />
          <% end %>
        </div>

</div>
        
<!-- Inspector -->
        <div class="mt-8 lg:mt-0">
          <.dashboard
            world={@world}
            citizen={selected_citizen}
            message_form={@message_form}
            selected_citizen_id={@selected_citizen_id}
            recipient_options={recipient_options(@world.citizens, @selected_citizen_id)}
            education_event={@education_event}
            beam_lab_topic={@beam_lab_topic}
          />
        </div>
      </div>
    </div>
  </div>
</Layouts.app>
