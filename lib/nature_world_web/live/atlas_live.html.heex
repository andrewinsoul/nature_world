<% selected_citizen =
  Enum.find(
    @world.citizens,
    &(&1.id == @selected_citizen_id)
  ) %>

<div class="world-background relative min-h-screen overflow-hidden text-white">
  
<!-- Ambient Background -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden">
    <div class="
        absolute
        -top-32
        left-1/3
        h-[600px]
        w-[600px]
        rounded-full
        bg-emerald-500/10
        blur-[180px]
        animate-pulse
      ">
    </div>

    <div class="
        absolute
        bottom-0
        right-0
        h-[500px]
        w-[500px]
        rounded-full
        bg-cyan-500/5
        blur-[200px]
      ">
    </div>
  </div>
  
<!-- Main Content -->
  <div class="relative z-10">
    
<!-- Hero -->
    <div class="pt-12 text-center">
      <h1 class="hero-title text-6xl font-black tracking-tight">
        Nature World
      </h1>

      <p class="mt-5 text-lg text-zinc-400">
        A Living Visualization of the BEAM Runtime
      </p>
    </div>
    
<!-- World -->
    <div class="
        mx-auto
        mt-16
        max-w-7xl
        px-6
        lg:grid
        lg:grid-cols-[1fr_360px]
        lg:gap-10
        items-start
      ">
      
<!-- Simulation -->
      <div class="
    world-stage
    relative
    h-[60vh]
    min-h-[500px]
    lg:h-[720px]
    w-full
  ">
        <div class="world-grid"></div>

        <div class="world-vignette"></div>
        
<!-- Citizens -->
        <%= for citizen <- @world.citizens do %>
          <.citizen
            citizen={citizen}
            selected={citizen.id == @selected_citizen_id}
          />
        <% end %>
        
<!-- Messages -->
        <%= for message <- @world.messages do %>
          <.message
            message={message}
            citizens={@world.citizens}
          />
        <% end %>
      </div>
      
<!-- Inspector -->
      <div class="mt-8 lg:mt-0">
        <.dashboard
          world={@world}
          citizen={selected_citizen}
        />
      </div>
    </div>
  </div>
</div>
